# Variáveis usadas pelo docker-compose.yml (substituição de ${...}).
# As variáveis específicas de cada app continuam em
# barbearia-rei-api/.env e barbearia-rei-web/.env — este arquivo é só
# pro nível do compose (banco de dados compartilhado entre api/worker).

POSTGRES_USER=barbearia
POSTGRES_PASSWORD=troque_esta_senha
POSTGRES_DB=barbearia_rei
