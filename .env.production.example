# Copiado para /opt/seu-barbeiro/.env na VPS. O deploy.sh gera este arquivo
# na primeira instalação com senhas aleatórias; não versionar o .env real.
APP_DOMAIN=seubarbeiro.impulsiodigital.com
OLD_DOMAIN=rei.impulsiodigital.com
FRONTEND_URL=https://seubarbeiro.impulsiodigital.com
PUBLIC_WEB_URL=https://seubarbeiro.impulsiodigital.com

POSTGRES_PASSWORD=
JWT_SECRET=

DEFAULT_SALON=seu-barbeiro
SALON_TIMEZONE=America/Sao_Paulo
NOTIFICATION_WORKER=true

# Notificações push no celular da equipe (o deploy.sh gera se faltarem).
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=https://seubarbeiro.impulsiodigital.com

# Provisionamento do primeiro acesso (npm run db:seed, só na instalação).
SHOP_NAME="Seu Barbeiro"
ADMIN_NAME=
ADMIN_EMAIL=
ADMIN_PASSWORD=
