DATABASE_URL="postgresql://user:password@localhost:5432/barbearia_rei"
JWT_SECRET="sua_chave_secreta_aqui_mude_em_producao"
PORT=3333
NODE_ENV=development
FRONTEND_URL="http://localhost:5173,http://localhost:4173"

# Domínio base — usado só como fallback de subdomínio (a resolução
# principal de tenant é por slug no path da URL).
BASE_DOMAIN="saas.impulsiodigital.com"

# Dev local (sem subdomínio real): slug do tenant a usar quando a requisição
# não tem subdomínio nem header x-tenant-slug. Deixe vazio em produção.
TENANT_DEV_SLUG="barbearia-do-rei"

# Redis para as filas de jobs em background (lembretes de WhatsApp, etc).
# Necessário rodar `npm run dev:worker` (processo separado da API).
REDIS_URL="redis://localhost:6379"

# Pasta onde uploads de logo/portfólio são salvos em disco (relativa à raiz
# do projeto da API). Servida publicamente em /uploads.
UPLOADS_DIR="uploads"

# Dados usados por `npm run db:seed` (prisma/seed.ts). Nenhum valor tem
# default sensível: se SEED_ADMIN_PASSWORD não for definida, uma senha
# aleatória é gerada e impressa uma única vez no console.
SEED_TENANT_SLUG="barbearia-do-rei"
SEED_TENANT_NAME="Barbearia do Rei"
SEED_ADMIN_NAME="Administrador"
SEED_ADMIN_EMAIL="admin@example.com"
SEED_ADMIN_PASSWORD=""
SEED_BARBER_NAME=""
SEED_BARBER_PHONE=""
SEED_BARBER_EMAIL=""
SEED_SHOP_NAME=""
SEED_SHOP_PHONE=""
SEED_SHOP_ADDRESS=""
SEED_SHOP_INSTAGRAM=""
