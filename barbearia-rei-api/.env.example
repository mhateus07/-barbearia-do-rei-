DATABASE_URL="postgresql://user:password@localhost:5432/barbearia_rei"
JWT_SECRET="sua_chave_secreta_aqui_mude_em_producao"
PORT=3333
NODE_ENV=development

# Um banco por estabelecimento; sem SALON_DATABASES, usa DATABASE_URL.
DEFAULT_SALON=barbearia-do-rei
# SALON_DATABASES='{"barbearia-do-rei":"postgresql://user:password@localhost:5432/barbearia_rei","outro-salao":"postgresql://user:password@localhost:5432/outro_salao"}'
FRONTEND_URL=http://localhost:5173
PUBLIC_WEB_URL=http://localhost:5173
SALON_TIMEZONE=America/Sao_Paulo
NOTIFICATION_WORKER=true

# Provisionamento de um novo salão (npm run db:seed).
SHOP_NAME="Meu salão"
ADMIN_EMAIL=""
ADMIN_PASSWORD=""
