generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ─── TENANTS ─────────────────────────────────────────────────────────────────

enum TenantStatus {
  TRIAL
  ACTIVE
  PAST_DUE
  SUSPENDED
}

model Tenant {
  id        String       @id @default(uuid())
  slug      String       @unique
  name      String
  status    TenantStatus @default(TRIAL)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  admins             Admin[]
  barbers            Barber[]
  services           Service[]
  clients            Client[]
  appointments       Appointment[]
  payments           Payment[]
  expenses           Expense[]
  settings           Settings[]
  loyaltyCards       LoyaltyCard[]
  commissionPayments CommissionPayment[]
  notificationLogs   NotificationLog[]
  waitlistEntries    WaitlistEntry[]
  packages           Package[]
  clientPackages     ClientPackage[]

  @@map("tenants")
}

model Admin {
  id           String   @id @default(uuid())
  name         String
  email        String
  passwordHash String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  tenant   Tenant @relation(fields: [tenantId], references: [id])
  tenantId String

  @@unique([tenantId, email])
  @@map("admins")
}

model Barber {
  id             String   @id @default(uuid())
  name           String
  phone          String?
  email          String?  @unique
  avatarUrl      String?
  isActive       Boolean  @default(true)
  commissionRate Decimal? @db.Decimal(5, 2)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  tenant   Tenant @relation(fields: [tenantId], references: [id])
  tenantId String

  appointments       Appointment[]
  commissionPayments CommissionPayment[]
  waitlistEntries    WaitlistEntry[]

  @@map("barbers")
}

model Service {
  id          String   @id @default(uuid())
  name        String
  description String?
  price       Decimal  @db.Decimal(10, 2)
  durationMin Int
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant   Tenant @relation(fields: [tenantId], references: [id])
  tenantId String

  appointmentServices AppointmentService[]
  waitlistEntries     WaitlistEntry[]
  packages            Package[]

  @@map("services")
}

model Client {
  id        String    @id @default(uuid())
  name      String
  phone     String
  email     String?
  birthDate DateTime?
  notes     String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  tenant   Tenant @relation(fields: [tenantId], references: [id])
  tenantId String

  appointments     Appointment[]
  loyaltyCard      LoyaltyCard?
  notificationLogs NotificationLog[]
  waitlistEntries  WaitlistEntry[]
  clientPackages   ClientPackage[]

  @@unique([tenantId, phone])
  @@unique([tenantId, email])
  @@map("clients")
}

enum AppointmentStatus {
  SCHEDULED
  CONFIRMED
  IN_PROGRESS
  COMPLETED
  CANCELLED
  NO_SHOW
}

model Appointment {
  id         String            @id @default(uuid())
  startsAt   DateTime
  endsAt     DateTime
  status     AppointmentStatus @default(SCHEDULED)
  notes      String?
  totalPrice Decimal           @db.Decimal(10, 2)
  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt

  client   Client @relation(fields: [clientId], references: [id])
  clientId String

  barber   Barber @relation(fields: [barberId], references: [id])
  barberId String

  tenant   Tenant @relation(fields: [tenantId], references: [id])
  tenantId String

  // Preenchido quando o agendamento é pago com sessão de um pacote em vez de
  // cobrado avulso — nesse caso totalPrice fica zerado (o valor já entrou na
  // venda do pacote)
  clientPackage   ClientPackage? @relation(fields: [clientPackageId], references: [id], onDelete: SetNull)
  clientPackageId String?

  services         AppointmentService[]
  payment          Payment?
  notificationLogs NotificationLog[]

  @@index([startsAt])
  @@index([barberId, startsAt])
  @@index([status])
  @@index([tenantId, startsAt])
  @@map("appointments")
}

model AppointmentService {
  id               String  @id @default(uuid())
  priceSnapshot    Decimal @db.Decimal(10, 2)
  durationSnapshot Int

  appointment   Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  appointmentId String

  service   Service @relation(fields: [serviceId], references: [id])
  serviceId String

  @@unique([appointmentId, serviceId])
  @@map("appointment_services")
}

enum PaymentMethod {
  CASH
  PIX
  CREDIT_CARD
  DEBIT_CARD
}

enum ExpenseCategory {
  RENT
  UTILITIES
  SUPPLIES
  SALARY
  EQUIPMENT
  MARKETING
  OTHER
}

enum ExpenseStatus {
  PENDING
  PAID
  OVERDUE
}

model Payment {
  id              String         @id @default(uuid())
  amount          Decimal        @db.Decimal(10, 2)
  method          PaymentMethod
  paidAt          DateTime       @default(now())
  notes           String?
  appointmentId   String?        @unique
  appointment     Appointment?   @relation(fields: [appointmentId], references: [id], onDelete: SetNull)
  clientPackageId String?        @unique
  clientPackage   ClientPackage? @relation(fields: [clientPackageId], references: [id], onDelete: SetNull)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  tenant   Tenant @relation(fields: [tenantId], references: [id])
  tenantId String

  @@index([paidAt])
  @@index([tenantId, paidAt])
  @@map("payments")
}

model Expense {
  id          String          @id @default(uuid())
  description String
  amount      Decimal         @db.Decimal(10, 2)
  category    ExpenseCategory
  dueDate     DateTime
  paidAt      DateTime?
  status      ExpenseStatus   @default(PENDING)
  notes       String?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  tenant   Tenant @relation(fields: [tenantId], references: [id])
  tenantId String

  @@index([dueDate])
  @@index([status])
  @@index([tenantId, dueDate])
  @@map("expenses")
}

// ─── SETTINGS ────────────────────────────────────────────────────────────────

model Settings {
  id        String   @id @default(uuid())
  key       String
  value     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant   Tenant @relation(fields: [tenantId], references: [id])
  tenantId String

  @@unique([tenantId, key])
  @@map("settings")
}

// ─── LOYALTY ─────────────────────────────────────────────────────────────────

model LoyaltyCard {
  id             String   @id @default(uuid())
  visitCount     Int      @default(0)
  pointsBalance  Int      @default(0)
  pointsEarned   Int      @default(0)
  pointsRedeemed Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  client   Client @relation(fields: [clientId], references: [id], onDelete: Cascade)
  clientId String @unique

  tenant   Tenant @relation(fields: [tenantId], references: [id])
  tenantId String

  @@map("loyalty_cards")
}

// ─── COMMISSION PAYMENTS ─────────────────────────────────────────────────────

model CommissionPayment {
  id               String   @id @default(uuid())
  periodFrom       DateTime
  periodTo         DateTime
  totalRevenue     Decimal  @db.Decimal(10, 2)
  commissionAmount Decimal  @db.Decimal(10, 2)
  commissionRate   Decimal  @db.Decimal(5, 2)
  notes            String?
  paidAt           DateTime @default(now())
  createdAt        DateTime @default(now())

  barber   Barber @relation(fields: [barberId], references: [id])
  barberId String

  tenant   Tenant @relation(fields: [tenantId], references: [id])
  tenantId String

  @@index([barberId])
  @@map("commission_payments")
}

// ─── NOTIFICATION LOGS ───────────────────────────────────────────────────────

enum NotificationStatus {
  PENDING
  SENT
  FAILED
}

enum NotificationType {
  APPOINTMENT_CONFIRMATION
  APPOINTMENT_REMINDER
  APPOINTMENT_CANCELLATION
  REVIEW_REQUEST
  WAITLIST_SLOT_OPEN
  CUSTOM
}

model NotificationLog {
  id        String             @id @default(uuid())
  type      NotificationType
  phone     String
  message   String
  status    NotificationStatus @default(PENDING)
  error     String?
  sentAt    DateTime?
  createdAt DateTime           @default(now())

  appointmentId String?
  appointment   Appointment? @relation(fields: [appointmentId], references: [id], onDelete: SetNull)

  clientId String?
  client   Client? @relation(fields: [clientId], references: [id], onDelete: SetNull)

  tenant   Tenant @relation(fields: [tenantId], references: [id])
  tenantId String

  @@map("notification_logs")
}

// ─── LISTA DE ESPERA ─────────────────────────────────────────────────────────

enum WaitlistStatus {
  WAITING
  NOTIFIED
  CONVERTED
  CANCELLED
}

model WaitlistEntry {
  id            String         @id @default(uuid())
  preferredDate DateTime
  status        WaitlistStatus @default(WAITING)
  notes         String?
  notifiedAt    DateTime?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  client   Client @relation(fields: [clientId], references: [id], onDelete: Cascade)
  clientId String

  // null = qualquer barbeiro serve
  barber   Barber? @relation(fields: [barberId], references: [id], onDelete: SetNull)
  barberId String?

  // null = qualquer serviço serve
  service   Service? @relation(fields: [serviceId], references: [id], onDelete: SetNull)
  serviceId String?

  tenant   Tenant @relation(fields: [tenantId], references: [id])
  tenantId String

  @@index([tenantId, preferredDate])
  @@index([status])
  @@map("waitlist_entries")
}

// ─── PACOTES DE SESSÕES ──────────────────────────────────────────────────────

// Catálogo: um tipo de pacote vendável (ex: "10 Cortes", 90 dias de validade)
model Package {
  id            String   @id @default(uuid())
  name          String
  description   String?
  totalSessions Int
  price         Decimal  @db.Decimal(10, 2)
  // null = sem validade (nunca expira)
  validityDays  Int?
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  service   Service @relation(fields: [serviceId], references: [id])
  serviceId String

  tenant   Tenant @relation(fields: [tenantId], references: [id])
  tenantId String

  clientPackages ClientPackage[]

  @@map("packages")
}

// Uma compra: instância de um Package pertencente a um Client, com saldo de
// sessões. sessionsTotal/pricePaid são snapshot da hora da compra — não
// mudam se o Package do catálogo for editado depois.
model ClientPackage {
  id            String    @id @default(uuid())
  sessionsTotal Int
  sessionsUsed  Int       @default(0)
  pricePaid     Decimal   @db.Decimal(10, 2)
  purchasedAt   DateTime  @default(now())
  // null = sem validade
  expiresAt     DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  client   Client @relation(fields: [clientId], references: [id], onDelete: Cascade)
  clientId String

  package   Package @relation(fields: [packageId], references: [id])
  packageId String

  tenant   Tenant @relation(fields: [tenantId], references: [id])
  tenantId String

  payment      Payment?
  appointments Appointment[]

  @@index([tenantId, clientId])
  @@map("client_packages")
}
