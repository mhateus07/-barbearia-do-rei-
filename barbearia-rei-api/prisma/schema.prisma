generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Admin {
  id           String   @id @default(uuid())
  name         String
  email        String   @unique
  role         String   @default("OWNER")
  barberId     String?
  isActive     Boolean  @default(true)
  passwordHash String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("admins")
}

model Barber {
  id             String    @id @default(uuid())
  name           String
  phone          String?
  email          String?   @unique
  avatarUrl      String?
  isActive       Boolean   @default(true)
  commissionRate Decimal?  @db.Decimal(5, 2)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  serviceOverrides   Json @default("{}")
  serviceIds         String[] @default([])
  schedules          WorkSchedule[]
  blocks             ScheduleBlock[]
  appointments       Appointment[]
  commissionPayments CommissionPayment[]

  @@map("barbers")
}

model Service {
  id          String   @id @default(uuid())
  name        String
  description String?
  price       Decimal  @db.Decimal(10, 2)
  returnDays  Int?
  processingMin Int @default(0)
  finishingMin Int @default(0)
  resourceId String?
  durationMin Int
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  appointmentServices AppointmentService[]

  @@map("services")
}

model Client {
  id        String    @id @default(uuid())
  name      String
  phone     String    @unique
  email     String?   @unique
  birthDate DateTime?
  marketingConsent Boolean @default(false)
  technicalRecords TechnicalRecord[]
  waitlist WaitlistEntry[]
  notes     String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  appointments     Appointment[]
  loyaltyCard      LoyaltyCard?
  notificationLogs NotificationLog[]

  @@map("clients")
}

enum AppointmentStatus {
  SCHEDULED
  CONFIRMED
  IN_PROGRESS
  COMPLETED
  CANCELLED
  NO_SHOW
}

model Appointment {
  id         String            @id @default(uuid())
  startsAt   DateTime
  endsAt     DateTime
  status     AppointmentStatus @default(SCHEDULED)
  notes      String?
  commissionRateSnapshot Decimal? @db.Decimal(5, 2)
  loyaltyCredited Boolean @default(false)
  source String @default("DIRECT")
  visitId String?
  returnOfId String?
  discount Decimal @default(0) @db.Decimal(10, 2)
  items OrderItem[]
  segments AppointmentSegment[]
  totalPrice Decimal           @db.Decimal(10, 2)
  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt

  client   Client @relation(fields: [clientId], references: [id])
  clientId String

  barber   Barber @relation(fields: [barberId], references: [id])
  barberId String

  services         AppointmentService[]
  payments         Payment[]
  notificationLogs NotificationLog[]

  @@index([startsAt])
  @@index([barberId, startsAt])
  @@index([status])
  @@map("appointments")
}

model AppointmentService {
  id               String  @id @default(uuid())
  priceSnapshot    Decimal @db.Decimal(10, 2)
  processingSnapshot Int @default(0)
  finishingSnapshot Int @default(0)
  resourceSnapshot String?
  durationSnapshot Int

  appointment   Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  appointmentId String

  service   Service @relation(fields: [serviceId], references: [id])
  serviceId String

  @@unique([appointmentId, serviceId])
  @@map("appointment_services")
}

enum PaymentMethod {
  CASH
  PIX
  CREDIT_CARD
  DEBIT_CARD
}

enum ExpenseCategory {
  RENT
  UTILITIES
  SUPPLIES
  SALARY
  EQUIPMENT
  MARKETING
  OTHER
}

enum ExpenseStatus {
  PENDING
  PAID
  OVERDUE
}

model Payment {
  id            String        @id @default(uuid())
  amount        Decimal       @db.Decimal(10, 2)
  method        PaymentMethod
  paidAt        DateTime      @default(now())
  notes         String?
  refundedAt    DateTime?
  refundReason  String?
  appointmentId String?
  appointment   Appointment?  @relation(fields: [appointmentId], references: [id], onDelete: SetNull)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@index([paidAt])
  @@map("payments")
}

model Expense {
  id          String          @id @default(uuid())
  description String
  amount      Decimal         @db.Decimal(10, 2)
  category    ExpenseCategory
  dueDate     DateTime
  paidAt      DateTime?
  status      ExpenseStatus   @default(PENDING)
  notes       String?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@index([dueDate])
  @@index([status])
  @@map("expenses")
}

// ─── SETTINGS ────────────────────────────────────────────────────────────────

model Settings {
  id        String   @id @default(uuid())
  key       String   @unique
  value     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("settings")
}

// ─── LOYALTY ─────────────────────────────────────────────────────────────────

model LoyaltyCard {
  id             String   @id @default(uuid())
  visitCount     Int      @default(0)
  pointsBalance  Int      @default(0)
  pointsEarned   Int      @default(0)
  pointsRedeemed Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  client   Client @relation(fields: [clientId], references: [id], onDelete: Cascade)
  clientId String @unique

  @@map("loyalty_cards")
}

// ─── COMMISSION PAYMENTS ─────────────────────────────────────────────────────

model CommissionPayment {
  id               String   @id @default(uuid())
  periodFrom       DateTime
  periodTo         DateTime
  totalRevenue     Decimal  @db.Decimal(10, 2)
  commissionAmount Decimal  @db.Decimal(10, 2)
  commissionRate   Decimal  @db.Decimal(5, 2)
  notes            String?
  paidAt           DateTime @default(now())
  createdAt        DateTime @default(now())

  barber   Barber @relation(fields: [barberId], references: [id])
  barberId String

  @@index([barberId])
  @@map("commission_payments")
}

// ─── NOTIFICATION LOGS ───────────────────────────────────────────────────────

enum NotificationStatus {
  PENDING
  SENT
  FAILED
}

enum NotificationType {
  APPOINTMENT_CONFIRMATION
  APPOINTMENT_REMINDER
  APPOINTMENT_CANCELLATION
  CUSTOM
}

model NotificationLog {
  id      String             @id @default(uuid())
  type    NotificationType
  phone   String
  message String
  status  NotificationStatus @default(PENDING)
  error   String?
  attempts Int @default(0)
  nextAttemptAt DateTime @default(now())
  dedupeKey String? @unique
  lockedAt DateTime?
  sentAt  DateTime?
  createdAt DateTime         @default(now())

  appointmentId String?
  appointment   Appointment? @relation(fields: [appointmentId], references: [id], onDelete: SetNull)

  clientId String?
  client   Client? @relation(fields: [clientId], references: [id], onDelete: SetNull)

  @@map("notification_logs")
}

model WorkSchedule {
  id String @id @default(uuid())
  barberId String
  barber Barber @relation(fields: [barberId], references: [id], onDelete: Cascade)
  weekday Int
  openMinute Int
  closeMinute Int
  @@unique([barberId, weekday])
  @@map("work_schedules")
}

model ScheduleBlock {
  id String @id @default(uuid())
  barberId String
  barber Barber @relation(fields: [barberId], references: [id], onDelete: Cascade)
  startsAt DateTime
  endsAt DateTime
  reason String
  @@index([barberId, startsAt])
  @@map("schedule_blocks")
}

model Resource {
  id String @id @default(uuid())
  name String
  isActive Boolean @default(true)
  @@map("resources")
}

model AppointmentSegment {
  id String @id @default(uuid())
  appointmentId String
  appointment Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  barberId String
  resourceId String?
  startsAt DateTime
  endsAt DateTime
  kind String
  @@index([barberId, startsAt])
  @@index([resourceId, startsAt])
  @@map("appointment_segments")
}

model TechnicalRecord {
  id String @id @default(uuid())
  clientId String
  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)
  authorId String
  formula String?
  products String?
  preferences String?
  notes String?
  photoUrls String[] @default([])
  photoConsent Boolean @default(false)
  createdAt DateTime @default(now())
  @@index([clientId, createdAt])
  @@map("technical_records")
}

model WaitlistEntry {
  id String @id @default(uuid())
  clientId String
  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)
  barberId String?
  serviceIds String[]
  from DateTime
  to DateTime
  status String @default("WAITING")
  offeredAt DateTime?
  expiresAt DateTime?
  reservedStart DateTime?
  reservedEnd DateTime?
  reservedBarberId String?
  token String? @unique
  appointmentId String? @unique
  createdAt DateTime @default(now())
  @@index([status, from])
  @@map("waitlist_entries")
}

model Outreach {
  id String @id @default(uuid())
  clientId String
  serviceId String
  token String @unique
  notificationId String?
  appointmentId String? @unique
  createdAt DateTime @default(now())
  @@index([clientId, createdAt])
  @@map("outreach")
}

model Product {
  id String @id @default(uuid())
  name String
  price Decimal @db.Decimal(10, 2)
  cost Decimal @db.Decimal(10, 2)
  stock Int @default(0)
  isActive Boolean @default(true)
  @@map("products")
}

model OrderItem {
  id String @id @default(uuid())
  appointmentId String
  appointment Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  productId String?
  description String
  quantity Int
  unitPrice Decimal @db.Decimal(10, 2)
  unitCost Decimal @db.Decimal(10, 2)
  @@map("order_items")
}
